---
import { TITULO } from "../data.ts";
import "../styles/global.css";
import { Icon } from "astro-icon/components";
---

<div class="bg-[url(../assets/montania.webp)] h-120 bg-center bg-cover">
    <header
        class="flex justify-between md:ml-20 ml-8 mr-10 lg:mx-20 items-center pt-12"
    >
        <h1 class="text-4xl lg:text-6xl font-bold text-white">
            Explora el Mundo
        </h1>
        <nav class="relative">
            <div class="flex flex-col justify-between items-center">
                <button
                    aria-expanded="false"
                    aria-controls="btn-desplegable"
                    id="btn-menu"
                    class="p-2 px-4 rounded-md cursor-pointer bg-gray-800 text-white lg:hidden"
                >
                    <Icon name="mdi:hamburger-menu" />
                </button>
            </div>

            <ul
                id="btn-desplegable"
                class="hidden absolute right-0 top-full z-20 mt-2 w-auto rounded-md bg-gray-800 p-4 text-white font-semibold text-lg shadow-lg lg:static lg:flex lg:w-auto lg:gap-12 lg:bg-transparent lg:text-2xl lg:shadow-none"
            >
                <li class="hover:underline"><a href="/">Inicio</a></li>
                <li class="hover:underline">
                    <a href="/destinos">Destinos</a>
                </li>
                <li class="hover:underline"><a href="/blog">Blog</a></li>
                <li class="hover:underline">
                    <a href="/contacto">Contacto</a>
                </li>
            </ul>
        </nav>
    </header>

    <div class="p-6 pt-20 lg:p-20 md:mt-5 text-center lg:text-start">
        <p
            class="text-white font-medium text-xl md:text-2xl block leading-tight"
        >
            {TITULO}
        </p>
        <button
            id="btn-leer"
            class="bg-white p-2 px-6 font-semibold rounded-md mt-25 cursor-pointer hover:bg-gray-800 hover:text-white
            transition duration-200 ease-out hover:scale-105"
            >Leer Más</button
        >
    </div>
</div>

<script>
    const btn = document.getElementById("btn-leer");
    const btnMenu = document.getElementById("btn-menu");
    const opciones = document.getElementById("btn-desplegable");

    btn?.addEventListener("click", () => {
        alert("Accion ejecutada");
    });

    btnMenu?.addEventListener("click", function () {
        const estaExpandido = btnMenu.getAttribute("aria-expanded") === "true";
        const nuevoEstado = !estaExpandido;

        btnMenu.setAttribute("aria-expanded", nuevoEstado ? "true" : "false");

        opciones?.classList.toggle("hidden", estaExpandido);
    });
</script>
