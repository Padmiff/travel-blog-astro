---
import { TITULO } from "../data.ts";
import "../styles/global.css";
---

<div class="bg-[url(../assets/montania.webp)] h-120 bg-center bg-cover">
    <header class="flex justify-between mx-20 items-center pt-12">
        <h1 class="text-6xl font-bold text-white">Explora el Mundo</h1>
        <nav>
            <ul class="text-white font-semibold text-2xl flex gap-12">
                <li class="hover:underline"><a href="/">Inicio</a></li>
                <li class="hover:underline">
                    <a href="/destinos">Destinos</a>
                </li>
                <li class="hover:underline"><a href="/blog">Blog</a></li>
                <li class="hover:underline">
                    <a href="/contacto">Contacto</a>
                </li>
            </ul>
        </nav>
    </header>

    <div class="p-20 mt-5">
        <p class="text-white font-medium text-2xl">{TITULO}</p>
        <button
            id="btn-leer"
            class="bg-white p-2 px-6 font-semibold rounded-md mt-25 cursor-pointer hover:bg-gray-800 hover:text-white
            transition duration-200 ease-out hover:scale-105"
            >Leer Más</button
        >
    </div>
</div>

<script>
    const btn = document.getElementById("btn-leer");

    if (btn) {
        btn.addEventListener("click", () => {
            alert("Accion ejecutada");
        });
    }
</script>
