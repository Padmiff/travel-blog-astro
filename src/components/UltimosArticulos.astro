---
import { ULTIMOS_ARTICULOS, TITULO_ARTICULOS } from "../data.ts";
---

<section>
    <h2 class="my-8 mx-20 text-[27px] font-bold border-b border-gray-500">
        {TITULO_ARTICULOS}
    </h2>

    <div class="mx-20 flex justify-between">
        {
            ULTIMOS_ARTICULOS.map((articulos) => (
                <article class="flex flex-col border border-gray-300 shadow-lg">
                    <img
                        src={articulos.imagen.src}
                        class="w-96 h-70 object-cover"
                        alt=""
                    />
                    <div class="p-6">
                        <h3 class="text-blue-700 text-2xl font-semibold mb-6">
                            {articulos.titulo}
                        </h3>
                        <p class="text-xl font-medium mb-3">
                            {articulos.descripcion}
                        </p>
                    </div>
                </article>
            ))
        }
    </div>
</section>
